corim-cbor-collection = {
  "__cmwc_t" => "tag:ietf.org,2026:corim",
  + cmw-label => [rim-cbor-content-format, bytes .cbor tagged-unsigned-corim-map]
}
cmw-label = text / int

; RFC Editor: replace 65000 with the CoAP Content-Format ID assigned to
; application/rim+cbor (TBD1), here and in the example, and remove this note.
rim-cbor-content-format = 65000
